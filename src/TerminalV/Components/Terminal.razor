@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_container" class="terminal-host" id="@SessionId" style="width:100%;height:100%;"></div>

@code {
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Terminal>? _dotNetRef;
    private bool _initialized;

    [Parameter] public string SessionId { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public int Cols { get; set; } = 80;
    [Parameter] public int Rows { get; set; } = 24;
    [Parameter] public string? FontFamily { get; set; }
    [Parameter] public int? FontSize { get; set; }
    [Parameter] public object? Theme { get; set; }
    [Parameter] public int? BuildNumber { get; set; }
    [Parameter] public EventCallback<string> OnData { get; set; }
    [Parameter] public EventCallback<string> OnTitleChanged { get; set; }
    [Parameter] public EventCallback<(int cols, int rows)> OnResized { get; set; }
    [Parameter] public EventCallback<string> OnLinkActivated { get; set; }

    [JSInvokable]
    public Task NotifyData(string data) => OnData.InvokeAsync(data);

    [JSInvokable]
    public Task NotifyTitleChanged(string title) => OnTitleChanged.InvokeAsync(title);

    [JSInvokable]
    public Task NotifyResized(int cols, int rows) => OnResized.InvokeAsync((cols, rows));

    [JSInvokable]
    public Task OnLinkActivated(string uri) => OnLinkActivated.InvokeAsync(uri);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;
        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/terminal.js");
            var options = new
            {
                fontFamily = FontFamily,
                fontSize = FontSize,
                theme = Theme,
                buildNumber = BuildNumber
            };
            await _module.InvokeVoidAsync("create", _container, SessionId, Cols, Rows, _dotNetRef, options);
        }
        catch (JSException)
        {
            // Fallback to global interop if ES module import is unavailable (e.g., WebView2 without import support)
            await JS.InvokeVoidAsync("terminal.create", _container, SessionId, Cols, Rows, _dotNetRef);
        }
    }

    public async Task WriteAsync(string data)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("write", SessionId, data);
        else
            await JS.InvokeVoidAsync("terminal.write", SessionId, data);
    }

    public async Task WritelnAsync(string data) => await WriteAsync(data + "\r\n");

    public async Task ClearAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("clear", SessionId);
        else
            await JS.InvokeVoidAsync("terminal.clear", SessionId);
    }

    public async Task FocusAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("focus", SessionId);
        else
            await JS.InvokeVoidAsync("terminal.focus", SessionId);
    }

    public async Task<(int cols, int rows)> FitAsync()
    {
        if (_module is not null)
        {
            var result = await _module.InvokeAsync<TerminalSize>("fit", SessionId);
            return (result.Cols, result.Rows);
        }
        var g = await JS.InvokeAsync<TerminalSize>("terminal.fit", SessionId);
        return (g.Cols, g.Rows);
    }

    public async Task ResizeAsync(int cols, int rows)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("resize", SessionId, cols, rows);
        else
            await JS.InvokeVoidAsync("terminal.resize", SessionId, cols, rows);
    }

    public async Task<string> GetBufferAsync()
    {
        if (_module is not null)
            return await _module.InvokeAsync<string>("getBuffer", SessionId);
        return await JS.InvokeAsync<string>("terminal.getBuffer", SessionId);
    }

    public async Task<bool> FindNextAsync(string query, bool caseSensitive = false)
    {
        if (_module is not null)
            return await _module.InvokeAsync<bool>("findNext", SessionId, query, new { caseSensitive });
        return await JS.InvokeAsync<bool>("terminal.findNext", SessionId, query, new { caseSensitive });
    }

    public async Task<bool> FindPreviousAsync(string query, bool caseSensitive = false)
    {
        if (_module is not null)
            return await _module.InvokeAsync<bool>("findPrevious", SessionId, query, new { caseSensitive });
        return await JS.InvokeAsync<bool>("terminal.findPrevious", SessionId, query, new { caseSensitive });
    }

    public async Task ClearSearchAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("clearSearchDecorations", SessionId);
        else
            await JS.InvokeVoidAsync("terminal.clearSearchDecorations", SessionId);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("dispose", SessionId);
            else
                await JS.InvokeVoidAsync("terminal.dispose", SessionId);
        }
        catch { }
        try { _dotNetRef?.Dispose(); } catch { }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }

    private sealed class TerminalSize
    {
        public int Cols { get; set; }
        public int Rows { get; set; }
    }
}
