<Window x:Class="TerminalV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TerminalV"
        Icon="pack://application:,,,/Assets/TerminalV.ico"
        Width="1220"
        Height="780"
        MinWidth="800"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0D10"
        Foreground="#E8EEF5"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8D0DA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3340" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4554" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A12616" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10141A"
                BorderBrush="#1C232C"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            IsHitTestVisible="False">
                    <Image Width="16"
                           Height="16"
                           Source="pack://application:,,,/Assets/TerminalV.ico"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TerminalV"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="#C8D0DA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}"
                            Click="Minimize_Click"
                            ToolTip="Свернуть">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Width="10"
                              Height="10"
                              Stretch="None"
                              Data="M 1,5 H 9" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Click="Maximize_Click"
                            ToolTip="Развернуть">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeGlyph"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Stretch="None"
                                  Data="M 1,1 H 9 V 9 H 1 Z" />
                            <Path x:Name="RestoreGlyph"
                                  Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Stretch="None"
                                  Data="M 3,1 H 9 V 7 M 1,3 H 7 V 9 H 1 Z" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}"
                            Click="Close_Click"
                            ToolTip="Закрыть">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Width="10"
                              Height="10"
                              Stretch="None"
                              Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 is a child HWND and eats WM_NCHITTEST where it touches the
             window edge (airspace): the parent WindowFrame hook then never sees
             left/right/bottom. Inset by ResizeBorder=6 to expose a WPF strip
             for resizing; collapsed to 0 when maximized in code-behind. -->
        <Grid x:Name="ContentRoot" Grid.Row="1" Margin="6,0,6,6">
            <TextBlock Text="Загрузка TerminalV…"
                       Foreground="#8B98A8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14" />
            <wv2:WebView2 x:Name="WebView" />
        </Grid>
    </Grid>
</Window>
