@page "/"
@using TerminalV.Mobile.Host
@using TerminalV.Ssh
@inject IJSRuntime JS
@inject SshService Ssh
@inject MobileDataStore Store
@inject MobileBridge Bridge
@implements IAsyncDisposable

<div id="mobile-config-host" style="@(showConfig ? "" : "display:none")">
<div class="mobile-root">
    <div class="connect-card">
        <div class="card-head">
            <h1>TerminalV Mobile — подключение</h1>
            <p>Настройте SSH/шлюз один раз — далее используйте интерфейс как на десктопе (сайдбар, табы, сплиты, поиск). Данные хранятся в Preferences.</p>
        </div>
        <div class="form-grid">
            <label class="field"><span>Хост</span><input @bind="host" placeholder="100.119.48.15" /></label>
            <label class="field field-sm"><span>Порт</span><input type="number" @bind="port" /></label>
            <label class="field"><span>Пользователь</span><input @bind="username" /></label>
            <label class="field"><span>Пароль</span><input type="password" @bind="password" /></label>
            <label class="field field-check"><input type="checkbox" @bind="useGateway" @bind:after="OnGatewayToggled" disabled="@useTailscale" /><span>Через шлюз TerminalV</span></label>
            @if (useGateway)
            {
                <label class="field" style="grid-column:1/-1"><span>Gateway URL</span><input @bind="gatewayUrl" placeholder="ws://100.119.48.15:5454" /></label>
                <label class="field" style="grid-column:1/-1"><span>Токен шлюза</span><input type="password" @bind="gatewayToken" /></label>
            }
            <label class="field field-check"><input type="checkbox" @bind="useTailscale" disabled="@useGateway" /><span>Вшитый Tailscale</span></label>
            @if (useTailscale)
            {
                <label class="field" style="grid-column:1/-1"><span>Tailscale Auth Key</span><input type="password" @bind="tailscaleAuthKey" /></label>
                <label class="field" style="grid-column:1/-1"><span>Hostname</span><input @bind="tailscaleHostname" /></label>
            }
        </div>
        @if (!string.IsNullOrEmpty(error)) { <div class="error">@error</div> }
        <div class="hint">После сохранения — закройте окно и используйте «Новая вкладка» в основном интерфейсе. Каждая вкладка = SSH-сессия к настроенному хосту.</div>
        <button class="primary" @onclick="SaveAndClose">Сохранить и показать терминал</button>
        <button class="ghost" style="margin-top:8px;width:100%" @onclick="CloseConfig">Отмена</button>
    </div>
</div>
</div>

<button id="mobile-config-fab" @onclick="OpenConfig" title="Настройка подключения" style="position:fixed;bottom:calc(12px + env(safe-area-inset-bottom));right:calc(12px + env(safe-area-inset-right));z-index:9999;background:#1E2631;color:#E8EEF5;border:1px solid #2A3340;border-radius:999px;padding:8px 12px;font-size:12px;max-width:42vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;@(showConfig ? "display:none" : "")">⚙ Подключение</button>

<style>
.mobile-root { max-width: 560px; margin: 0 auto; padding: 16px; color: #E8EEF5; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cascadia Code", monospace; }
#mobile-config-host { position:fixed; inset:0; z-index:10000; background:rgba(11,13,16,0.92); overflow-y:auto; overflow-x:hidden; -webkit-overflow-scrolling:touch; overscroll-behavior:contain; padding:16px; padding-bottom: max(16px, env(safe-area-inset-bottom)); display:flex; flex-direction:column; align-items:stretch; }
.connect-card { background: #0F1318; border: 1px solid #1E2631; padding: 18px; max-width:560px; width:100%; margin: 0 auto; flex-shrink:0; max-height:none; }
.card-head h1 { font-size: 18px; margin:0 0 6px; }
.card-head p { font-size: 13px; color:#8A96A6; }
.form-grid { display:grid; grid-template-columns: 1fr 96px; gap:10px; }
.field { display:flex; flex-direction:column; gap:5px; min-width:0; }
.field span { font-size:12px; color:#9AA8BC; }
.field input:not([type=checkbox]) { background:#0B0D10; border:1px solid #26303D; color:#E8EEF5; padding:8px 10px; font-size:16px; }
.field-check { flex-direction:row; align-items:center; grid-column:1/-1; gap:8px; }
.error { background:#2B1212; border:1px solid #5A1E1E; color:#FF9E9E; padding:8px; margin:10px 0; }
.primary { width:100%; background:#0F766E; color:#fff; border:1px solid #115E57; padding:10px; font-weight:600; cursor:pointer; }
.hint { font-size:11px; color:#6E7C90; margin:8px 0; }
@@media (max-width: 400px) { .form-grid { grid-template-columns: 1fr; } .field.field-sm { grid-column:1/-1; } }
</style>

@code {
    private string host = "100.119.48.15";
    private int port = 22;
    private string username = "local";
    private string password = "5454";
    private bool useGateway = false;
    private string gatewayUrl = "ws://100.119.48.15:5454";
    private string gatewayToken = "";
    private bool useTailscale = false;
    private string tailscaleAuthKey = "";
    private string tailscaleHostname = "terminalv-mobile";
    private string error = "";
    private bool showConfig = false;
    private bool bridgeReady = false;

    protected override void OnInitialized()
    {
        try
        {
            host = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(host), host);
            port = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(port), port);
            username = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(username), username);
            password = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(password), password);
            useGateway = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(useGateway), useGateway);
            gatewayUrl = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(gatewayUrl), gatewayUrl);
            gatewayToken = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(gatewayToken), gatewayToken);
            useTailscale = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(useTailscale), useTailscale);
            tailscaleAuthKey = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(tailscaleAuthKey), tailscaleAuthKey);
            tailscaleHostname = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(tailscaleHostname), tailscaleHostname);
            // Show config on first launch if host is default and no sessions exist
            if (string.IsNullOrWhiteSpace(host) || host == "100.119.48.15" && Store.LoadSessions().Count == 0)
            {
                // keep hidden by default to show desktop UI; user can open via FAB
                showConfig = false;
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Bridge.SetJS(JS);
            // Let shim know DotNet is ready
            await JS.InvokeVoidAsync("eval", "window.__mobileBridgeReady = true");
            Bridge.SendInit();
            bridgeReady = true;
        }
        catch { }
    }

    private void SavePreferences()
    {
        try
        {
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(host), host);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(port), port);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(username), username);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(password), password);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(useGateway), useGateway);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(gatewayUrl), gatewayUrl);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(gatewayToken), gatewayToken);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(useTailscale), useTailscale);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(tailscaleAuthKey), tailscaleAuthKey);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(tailscaleHostname), tailscaleHostname);
        }
        catch { }
    }

    private void OnGatewayToggled()
    {
        if (useGateway && port == 22) port = 5454;
        else if (!useGateway && port == 5454) port = 22;
        if (useGateway && string.IsNullOrWhiteSpace(gatewayUrl)) gatewayUrl = $"ws://{host.Trim()}:{port}";
    }

    private void OpenConfig() { showConfig = true; StateHasChanged(); }
    private void CloseConfig() { showConfig = false; StateHasChanged(); }
    private void SaveAndClose()
    {
        if (string.IsNullOrWhiteSpace(host)) { error = "Заполни хост."; return; }
        if (port < 1 || port > 65535) { error = "Порт 1..65535."; return; }
        SavePreferences();
        error = "";
        showConfig = false;
        // Re-init bridge so next create uses new prefs
        try { Bridge.SendInit(); } catch { }
        StateHasChanged();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
