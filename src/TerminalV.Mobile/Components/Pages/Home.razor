@page "/"
@using TerminalV.Mobile.Host
@using TerminalV.Ssh
@using System.Text.Json
@inject IJSRuntime JS
@inject SshService Ssh
@inject MobileDataStore Store
@inject MobileBridge Bridge
@inject TerminalV.Mobile.Tailscale.TailnetAccount Account
@implements IAsyncDisposable

<div id="mobile-config-host" role="dialog" aria-modal="true" aria-labelledby="connection-title" style="@(showConfig ? "" : "display:none")">
<div class="mobile-root">
    <div class="connect-card">
        <div class="card-head">
            <div><div class="connection-eyebrow">TERMINALV MOBILE</div><h1 id="connection-title">Подключение</h1></div>
            <button id="connection-close" type="button" class="connection-close" @onclick="CloseConfig" aria-label="Закрыть подключение" title="Закрыть">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
        </div>
        <p class="connection-intro">Выберите компьютер, чтобы продолжить его сессии на телефоне.</p>
        @if (CanReconnectGateway)
        {
            <div class="saved-computer"><span>Выбранный компьютер</span><strong>@SavedComputerName</strong><button class="ghost" disabled="@accountBusy" @onclick="ReconnectAsync">Переподключиться</button></div>
        }
        <button class="primary" disabled="@accountBusy" @onclick="LoginAsync">@(string.IsNullOrEmpty(accountLogin) ? "Войти через Tailscale" : "Найти компьютеры")</button>
        @if (!string.IsNullOrEmpty(accountLogin))
        {
            <div class="connection-account"><span title="@accountLogin">@accountLogin</span><button class="ghost" disabled="@accountBusy" @onclick="LogoutAsync">Выйти</button></div>
        }
        @if (accountBusy) { <button class="ghost operation-cancel" @onclick="CancelAccount">Отменить операцию</button> }
        @if (!string.IsNullOrEmpty(accountStatus)) { <p class="connection-status" role="status">@accountStatus</p> }
        @if (computers.Count > 0)
        {
            <div class="connection-computers" aria-label="Доступные компьютеры">
            @foreach (var computer in computers)
            {
                <button class="computer-choice" disabled="@accountBusy" @onclick="() => ConnectComputerAsync(computer)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v13H3zM8 21h8M12 17v4" /></svg>
                    <span class="computer-choice-copy"><strong>@computer.Name</strong><span>@(computer.Approved ? "Открыть сессии" : "Подтвердить доступ на компьютере")</span></span>
                    <span aria-hidden="true">›</span>
                </button>
            }
            </div>
        }
        @if (!string.IsNullOrEmpty(accountError)) { <div class="error" role="alert">@accountError</div> }
        <details class="connection-details">
            <summary>Другой порт шлюза</summary>
            <label class="field"><span>Порт TerminalV на ПК</span><input type="number" min="1" max="65535" @bind="discoveryPort" /></label>
        </details>
        <details class="connection-details">
        <summary>Ручное подключение по SSH или токену</summary>
        <div class="form-grid">
            <label class="field"><span>Хост</span><input @bind="host" placeholder="100.119.48.15" /></label>
            <label class="field field-sm"><span>Порт</span><input type="number" @bind="port" /></label>
            <label class="field field-wide"><span>Пользователь</span><input @bind="username" /></label>
            <label class="field field-wide"><span>Пароль</span><input type="password" @bind="password" /></label>
            <label class="field field-check"><input type="checkbox" @bind="useGateway" @bind:after="OnGatewayToggled" disabled="@useTailscale" /><span>Через шлюз TerminalV</span></label>
            @if (useGateway)
            {
                <label class="field" style="grid-column:1/-1"><span>Gateway URL</span><input @bind="gatewayUrl" placeholder="ws://100.119.48.15:5454" /></label>
                <label class="field" style="grid-column:1/-1"><span>Токен шлюза</span><input type="password" @bind="gatewayToken" /></label>
            }
            <label class="field field-check"><input type="checkbox" @bind="useTailscale" disabled="@useGateway" /><span>Вшитый Tailscale</span></label>
            @if (useTailscale)
            {
                <label class="field" style="grid-column:1/-1"><span>Tailscale Auth Key</span><input type="password" @bind="tailscaleAuthKey" /></label>
                <label class="field" style="grid-column:1/-1"><span>Hostname</span><input @bind="tailscaleHostname" /></label>
            }
        </div>
        @if (!string.IsNullOrEmpty(error)) { <div class="error">@error</div> }
        <div class="hint">Новые вкладки будут открываться на этом компьютере. После сохранения можно вернуться к сессиям.</div>
        @if (!useGateway) { <div class="hint">Для повторного подключения сохранённой SSH-сессии нажмите «Перезапустить» в терминале.</div> }
        <button class="primary" @onclick="SaveAndClose">Сохранить и показать терминал</button>
        </details>
        <button class="ghost connection-done" @onclick="CloseConfig">Вернуться к сессиям</button>
    </div>
</div>
</div>

<style>
#mobile-config-host { position:fixed; inset:0; top:var(--connection-viewport-top, 0px); bottom:auto; height:var(--connection-viewport-height, 100dvh); z-index:10000; background:color-mix(in srgb, var(--bg) 92%, transparent); overflow-y:auto; overflow-x:hidden; -webkit-overflow-scrolling:touch; overscroll-behavior:contain; padding:max(16px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left)); display:flex; align-items:flex-start; }
#mobile-config-host .mobile-root { width:100%; max-width:520px; margin:auto; color:var(--text); font-family:var(--font-ui); }
#mobile-config-host .connect-card { background:var(--sidebar); border:1px solid var(--border-soft); border-radius:16px; padding:20px; width:100%; }
#mobile-config-host .card-head { display:flex; align-items:center; justify-content:space-between; gap:12px; }
#mobile-config-host .connection-eyebrow { font-size:10px; letter-spacing:.12em; color:var(--label); margin-bottom:6px; }
#mobile-config-host h1 { font-size:22px; line-height:1.2; margin:0; font-weight:600; }
#mobile-config-host .connection-close { width:44px; height:44px; flex-shrink:0; padding:10px; border:1px solid var(--border-soft); border-radius:10px; color:var(--text); background:var(--surface); }
#mobile-config-host svg { width:22px; height:22px; flex-shrink:0; }
#mobile-config-host .connection-intro, #mobile-config-host .connection-status { font-size:14px; line-height:1.55; color:var(--label); margin:16px 0; overflow-wrap:anywhere; }
#mobile-config-host .primary { width:100%; min-height:48px; background:var(--accent); color:var(--ink); border:1px solid transparent; border-radius:10px; padding:12px 16px; font:600 14px var(--font-ui); cursor:pointer; }
#mobile-config-host button:disabled { opacity:.55; cursor:default; }
#mobile-config-host .ghost { min-height:44px; border-radius:10px; padding:10px 12px; font:14px var(--font-ui); }
#mobile-config-host .connection-account { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:8px; font-size:12px; color:var(--label); }
#mobile-config-host .connection-account > span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
#mobile-config-host .connection-account > button { flex-shrink:0; }
#mobile-config-host .operation-cancel { width:100%; margin-top:8px; }
#mobile-config-host .connection-computers { display:grid; gap:8px; margin:16px 0; }
#mobile-config-host .saved-computer { display:grid; gap:6px; background:var(--surface); border:1px solid var(--border-soft); border-radius:12px; padding:12px; margin:16px 0; }
#mobile-config-host .saved-computer > span { font-size:12px; color:var(--label); }
#mobile-config-host .saved-computer > strong { font-size:14px; overflow-wrap:anywhere; }
#mobile-config-host .saved-computer > button { margin-top:6px; }
#mobile-config-host .computer-choice { display:flex; align-items:center; gap:12px; width:100%; min-height:68px; padding:12px; text-align:left; color:var(--text); background:var(--surface); border:1px solid var(--border-soft); border-radius:12px; }
#mobile-config-host .computer-choice:hover { border-color:var(--accent); background:var(--accent-wash); }
#mobile-config-host .computer-choice-copy { display:flex; flex:1; min-width:0; flex-direction:column; gap:4px; }
#mobile-config-host .computer-choice-copy strong { font-size:14px; font-weight:600; overflow-wrap:anywhere; }
#mobile-config-host .computer-choice-copy > span { font-size:12px; color:var(--label); }
#mobile-config-host .connection-details { margin-top:16px; border-top:1px solid var(--border-soft); padding-top:4px; }
#mobile-config-host summary { min-height:48px; padding:14px 0; font-size:13px; cursor:pointer; color:var(--label); }
#mobile-config-host .form-grid { display:grid; grid-template-columns:minmax(0,1fr) 96px; gap:12px; }
#mobile-config-host .field { display:flex; flex-direction:column; gap:6px; min-width:0; }
#mobile-config-host .field-wide { grid-column:1/-1; }
#mobile-config-host .field span { font-size:12px; color:var(--label); }
#mobile-config-host .field input:not([type=checkbox]) { width:100%; min-width:0; min-height:46px; background:var(--bg); border:1px solid var(--border-soft); border-radius:8px; color:var(--text); padding:10px 12px; font:16px var(--font-ui); user-select:text; }
#mobile-config-host .field-check { flex-direction:row; align-items:center; grid-column:1/-1; gap:10px; min-height:44px; }
#mobile-config-host .field-check input { width:20px; height:20px; flex-shrink:0; accent-color:var(--accent); }
#mobile-config-host .error { background:color-mix(in srgb,var(--danger) 9%,var(--sidebar)); border:1px solid color-mix(in srgb,var(--danger) 50%,var(--sidebar)); color:var(--danger); border-radius:10px; padding:12px; margin:12px 0; font-size:13px; line-height:1.5; overflow-wrap:anywhere; }
#mobile-config-host .hint { font-size:12px; color:var(--label); line-height:1.5; margin:12px 0; }
#mobile-config-host .connection-done { width:100%; margin-top:20px; }
@@media (max-width:400px) { #mobile-config-host .connect-card { padding:16px; } #mobile-config-host .form-grid { grid-template-columns:1fr; } #mobile-config-host .field.field-sm { grid-column:1/-1; } }
</style>

@code {
    private string host = "100.119.48.15";
    private int port = 22;
    private string username = "local";
    private string password = "5454";
    private bool useGateway = false;
    private string gatewayUrl = "ws://100.119.48.15:5454";
    private string gatewayToken = "";
    private bool useTailscale = false;
    private string tailscaleAuthKey = "";
    private string tailscaleHostname = "terminalv-mobile";
    private string error = "";
    private bool showConfig = false;
    private DotNetObjectReference<Home>? bridgeReference;
    private bool? reportedConfigVisibility;
    private bool accountBusy;
    private string accountLogin = "", accountStatus = "", accountError = "";
    private int discoveryPort = 5454;
    private List<TerminalV.Mobile.Tailscale.TailnetComputer> computers = new();
    private CancellationTokenSource? accountOperation;

    private bool CanReconnectGateway => Microsoft.Maui.Storage.Preferences.Default.Get("useGateway", false)
        && !string.IsNullOrWhiteSpace(Microsoft.Maui.Storage.Preferences.Default.Get("gatewayUrl", ""));
    private string SavedComputerName
    {
        get
        {
            if (Microsoft.Maui.Storage.Preferences.Default.Get("tailnetGateway", false))
            {
                var name = Microsoft.Maui.Storage.Preferences.Default.Get("tailnetComputerName", "");
                if (!string.IsNullOrWhiteSpace(name)) return name;
            }
            var url = Microsoft.Maui.Storage.Preferences.Default.Get("gatewayUrl", "");
            return Uri.TryCreate(url, UriKind.Absolute, out var address) ? address.Host : "Компьютер";
        }
    }

    private async Task ReconnectAsync()
    {
        if (accountBusy) return;
        accountBusy = true;
        showConfig = false;
        try { await Bridge.SendInitAsync(reconnect: true); }
        catch (Exception ex) { accountError = ex.Message; showConfig = true; }
        finally { accountBusy = false; }
    }

    private void CancelAccount() => accountOperation?.Cancel();
    private async Task LoginAsync()
    {
        if (accountBusy) return;
        if (discoveryPort is < 1 or > 65535) { accountError = "Порт должен быть от 1 до 65535."; return; }
        accountOperation?.Dispose();
        accountOperation = new CancellationTokenSource(TimeSpan.FromMinutes(3));
        var ct = accountOperation.Token;
        accountBusy = true; accountError = ""; accountStatus = "Подключение к Tailscale…"; computers.Clear();
        try
        {
            var status = await Account.StatusAsync(true, ct);
            var opened = false;
            while (!status.Running)
            {
                if (!opened && Uri.TryCreate(status.AuthUrl, UriKind.Absolute, out var url)
                    && url.Scheme == "https" && (url.Host == "tailscale.com" || url.Host.EndsWith(".tailscale.com", StringComparison.OrdinalIgnoreCase)))
                {
                    await Microsoft.Maui.ApplicationModel.Browser.Default.OpenAsync(url, Microsoft.Maui.ApplicationModel.BrowserLaunchMode.External);
                    opened = true;
                }
                accountStatus = status.State == "NeedsMachineAuth" ? "Подтвердите устройство в панели Tailscale." : "Завершите вход в браузере и вернитесь в TerminalV.";
                StateHasChanged();
                await Task.Delay(1000, ct);
                status = await Account.StatusAsync(false, ct);
            }
            accountLogin = status.Login;
            accountStatus = "Ищу компьютеры с запущенным TerminalV…";
            StateHasChanged();
            computers = await Account.FindComputersAsync(status, discoveryPort, ct);
            accountStatus = computers.Count == 0 ? "ПК не найден. Запустите новую версию TerminalV на компьютере, включите шлюз в настройках и проверьте доступ через Tailscale." : "Выберите компьютер.";
        }
        catch (OperationCanceledException) { accountStatus = "Вход или поиск остановлен. Можно повторить."; }
        catch (Exception ex) { accountError = ex.Message; accountStatus = ""; }
        finally { accountBusy = false; }
    }
    private async Task ConnectComputerAsync(TerminalV.Mobile.Tailscale.TailnetComputer computer)
    {
        accountOperation?.Dispose(); accountOperation = new CancellationTokenSource(TimeSpan.FromSeconds(70));
        accountBusy = true; accountError = ""; accountStatus = "Подтвердите доступ в окне TerminalV на ПК.";
        try
        {
            await Account.PairAsync(computer, accountOperation.Token);
            Microsoft.Maui.Storage.Preferences.Default.Set("tailnetGateway", true);
            Microsoft.Maui.Storage.Preferences.Default.Set("useGateway", true);
            Microsoft.Maui.Storage.Preferences.Default.Set("useTailscale", false);
            Microsoft.Maui.Storage.Preferences.Default.Set("gatewayUrl", $"ws://{computer.Ip}:{computer.Port}");
            Microsoft.Maui.Storage.Preferences.Default.Set("tailnetComputerId", computer.Id);
            Microsoft.Maui.Storage.Preferences.Default.Set("tailnetComputerName", computer.Name);
            Microsoft.Maui.Storage.Preferences.Default.Set("tailnetComputerPort", computer.Port);
            useGateway = true; useTailscale = false; gatewayUrl = $"ws://{computer.Ip}:{computer.Port}";
            showConfig = false;
            await Bridge.SendInitAsync(reconnect: true);
            accountStatus = "";
        }
        catch (Exception ex) { accountError = ex is OperationCanceledException ? "Подключение отменено." : ex.Message; }
        finally { accountBusy = false; }
    }
    private async Task LogoutAsync()
    {
        accountBusy = true;
        try
        {
            foreach (var session in Ssh.List()) Ssh.Remove(session.Id);
            await Account.LogoutAsync(CancellationToken.None);
            accountLogin = ""; computers.Clear(); accountStatus = "Вы вышли из Tailscale.";
            await Bridge.SendInitAsync(reconnect: true, connect: false);
        }
        catch (Exception ex) { accountError = ex.Message; }
        finally { accountBusy = false; }
    }

    protected override void OnInitialized()
    {
        try
        {
            host = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(host), host);
            port = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(port), port);
            username = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(username), username);
            password = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(password), password);
            useGateway = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(useGateway), useGateway);
            gatewayUrl = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(gatewayUrl), gatewayUrl);
            gatewayToken = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(gatewayToken), gatewayToken);
            useTailscale = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(useTailscale), useTailscale);
            tailscaleAuthKey = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(tailscaleAuthKey), tailscaleAuthKey);
            tailscaleHostname = Microsoft.Maui.Storage.Preferences.Default.Get(nameof(tailscaleHostname), tailscaleHostname);
            // First launch shows configuration; the sidebar connection card reopens it.
            if (Store.LoadSessions().Count == 0)
            {
                showConfig = true;
            }
            else if (string.IsNullOrWhiteSpace(host))
            {
                showConfig = true;
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                Bridge.SetJS(JS);
                bridgeReference = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("__tvSetBridge", bridgeReference);
            }
            if (reportedConfigVisibility != showConfig)
            {
                reportedConfigVisibility = showConfig;
                await JS.InvokeVoidAsync("__tvConnectionConfig", showConfig);
            }
        }
        catch (Exception ex) { error = ex.Message; showConfig = true; StateHasChanged(); }
    }

    [JSInvokable]
    public async Task HandleMessage(string json)
    {
        try
        {
            using var message = JsonDocument.Parse(json);
            if (message.RootElement.ValueKind == JsonValueKind.Object
                && message.RootElement.TryGetProperty("type", out var type) && type.ValueKind == JsonValueKind.String)
            {
                if (type.GetString() == "open-connection") { await InvokeAsync(OpenConfig); return; }
                if (type.GetString() == "close-connection") { await InvokeAsync(CloseConfig); return; }
            }
        }
        catch (JsonException) { return; }
        await Bridge.Handle(json);
    }

    private void SavePreferences()
    {
        try
        {
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(host), host);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(port), port);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(username), username);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(password), password);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(useGateway), useGateway);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(gatewayUrl), gatewayUrl);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(gatewayToken), gatewayToken);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(useTailscale), useTailscale);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(tailscaleAuthKey), tailscaleAuthKey);
            Microsoft.Maui.Storage.Preferences.Default.Set(nameof(tailscaleHostname), tailscaleHostname);
        }
        catch { }
    }

    private void OnGatewayToggled()
    {
        if (useGateway && port == 22) port = 5454;
        else if (!useGateway && port == 5454) port = 22;
        if (useGateway && string.IsNullOrWhiteSpace(gatewayUrl)) gatewayUrl = $"ws://{host.Trim()}:{port}";
    }

    private void OpenConfig() { showConfig = true; StateHasChanged(); }
    private void CloseConfig() { CancelAccount(); showConfig = false; StateHasChanged(); }
    private async Task SaveAndClose()
    {
        if (string.IsNullOrWhiteSpace(host)) { error = "Заполни хост."; return; }
        if (port < 1 || port > 65535) { error = "Порт 1..65535."; return; }
        SavePreferences();
        Microsoft.Maui.Storage.Preferences.Default.Set("tailnetGateway", false);
        error = "";
        showConfig = false;
        // Re-init bridge so next create uses new prefs
        await Bridge.SendInitAsync(reconnect: true);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        accountOperation?.Cancel(); accountOperation?.Dispose();
        try { await JS.InvokeVoidAsync("__tvSetBridge", (object?)null); } catch { }
        bridgeReference?.Dispose();
    }
}
