<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/TerminalV/Extensions/*.cs" Link="Extensions/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/TerminalV.Extensibility/TerminalV.Extensibility.csproj" />
    <ProjectReference Include="../../examples/extensions/terminalv.hello/host/HelloExtension.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.8" />
  </ItemGroup>
</Project>
