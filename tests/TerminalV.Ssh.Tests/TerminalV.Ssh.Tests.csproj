<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/TerminalV/Ssh/*.cs" Link="Ssh/%(Filename)%(Extension)" />
    <Compile Include="../../src/TerminalV/Gateway/GatewayServer.cs" Link="Gateway/GatewayServer.cs" />
    <Compile Include="../../src/TerminalV/Gateway/IGatewaySessionBackend.cs" Link="Gateway/IGatewaySessionBackend.cs" />
  </ItemGroup>
</Project>
